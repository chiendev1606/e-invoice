    {
      "name": "create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    var location = pm.response.headers.get(\"Location\");",
              "    if (location) {",
              "        var userId = location.split(\"/\").pop();",
              "        pm.environment.set(\"userId\", userId);",
              "        console.log(\"✅ Tạo user thành công. Đã lưu userId: \" + userId);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{clientToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"johndoe1\",\r\n    \"enabled\": true,\r\n    \"email\": \"johndoe1@yopmail.com\",\r\n    \"emailVerified\": true,\r\n    \"firstName\": \"John\",\r\n    \"lastName\": \"Doe\",\r\n    \"credentials\": [\r\n        {\r\n            \"type\": \"password\",\r\n            \"value\": \"123456\",\r\n            \"temporary\": false\r\n        }\r\n    ]\r\n}",
          "options": {
