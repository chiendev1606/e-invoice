{
  "name": "user-access-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["user-access"],
  "projectType": "application",
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/user-access-e2e/jest.config.ts",
        "passWithNoTests": true
      },
      "dependsOn": ["user-access:build", "user-access:serve"]
    }
  }
}
